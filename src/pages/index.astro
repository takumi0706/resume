---
import { getCollection } from "astro:content";
import Base from "@layouts/Base.astro";
import Chip from "@components/Chip.astro";
import Facts from "@components/Facts.astro";
import type { Fact } from "@components/Facts.astro";

// 事実は src/content/ 以下のコンテンツファイルが単一の情報源。
// このファイルには経歴データを直書きしない。

interface IndexRow {
  year: string;
  what: string;
  href: string | null;
  role: string;
}

interface IndexGroup {
  group: string;
  rows: IndexRow[];
}

const byDescending = (a: string, b: string): number => b.localeCompare(a);
const yearOf = (date: string): string => date.slice(0, 4);

const community = await getCollection("community");
const oss = await getCollection("oss");
const work = await getCollection("work");
const awards = await getCollection("awards");

const groups: IndexGroup[] = [
  {
    group: "コミュニティ",
    rows: community
      .sort((a, b) => byDescending(a.data.date, b.data.date))
      .map((entry) => ({
        year: yearOf(entry.data.date),
        what: entry.data.event,
        href: entry.data.url ?? null,
        role: entry.data.role,
      })),
  },
  {
    group: "オープンソース",
    rows: oss
      .sort((a, b) => byDescending(a.data.released, b.data.released))
      .map((entry) => ({
        year: yearOf(entry.data.released),
        what: entry.data.name,
        href: entry.data.url,
        role:
          entry.data.stars === undefined
            ? entry.data.role
            : `${entry.data.role} · ${entry.data.stars}★`,
      })),
  },
  {
    group: "職務",
    rows: work
      .sort((a, b) => byDescending(a.data.start, b.data.start))
      .map((entry) => ({
        year: yearOf(entry.data.start),
        what: entry.data.company,
        href: entry.data.companyUrl ?? null,
        role: entry.data.title,
      })),
  },
  {
    group: "受賞",
    rows: awards
      .sort((a, b) => byDescending(a.data.date, b.data.date))
      .map((entry) => ({
        year: yearOf(entry.data.date),
        what: entry.data.event,
        href: entry.data.url ?? null,
        role: entry.data.award,
      })),
  },
];

// 現在地の定義リストで参照する現職と直近のカンファレンス。
const current = work.find((entry) => entry.data.end === null && entry.data.employment === "正社員");
const upcoming = community
  .slice()
  .sort((a, b) => byDescending(a.data.date, b.data.date))
  .at(0);

const jpDate = (date: string): string =>
  date.replace(/^(\d{4})-(\d{2})-(\d{2})$/, "$1年$2月$3日");

const facts: Fact[] = [];

if (current) {
  facts.push({ key: "現職", value: current.data.company, sub: current.data.title });
  facts.push({ key: "担当", value: current.data.summary });
  if (current.data.stack.length > 0) {
    facts.push({ key: "技術", value: current.data.stack.join(" · ") });
  }
}

if (upcoming) {
  facts.push({
    key: "いま",
    value: `${upcoming.data.event} ${upcoming.data.role}`,
    sub: [jpDate(upcoming.data.date), upcoming.data.venue].filter(Boolean).join(" · "),
    tnum: true,
  });
}
---

<Base
  title="小山田 卓生 — Takumi Oyamada"
  description="小山田卓生（@takumi0706）のポートフォリオ。LINEヤフー株式会社のソフトウェアエンジニア。Hono Conference in Tokyo 2026 実行委員長。"
>
  {/* H1 · Marquee — knobs: size=xxl, alignment=left-bias, underlay=rule-below
      Marquee Hero は本来サブヘッドを置かない形だが、個人サイトの看板として
      名前・読み・ハンドルの3行を出す。参照した shunsock/resume と同じ構成。 */}
  <section class="hero">
    <div class="shell">
      <h1 class="hero__display">Takumi Oyamada</h1>
      <p class="hero__name">小山田 卓生</p>
      <p class="hero__handle">also known as @takumi0706</p>
    </div>
  </section>

  <div class="shell"><hr class="rule-thick" /></div>

  {/* 現在地。散文ではなく定義リストで置く。
      同じ事実を文章にすると読まないと分からなくなる。1行1事実にする。 */}
  <section class="now">
    <div class="shell">
      <Facts facts={facts} />
    </div>
  </section>

  {/* S2 · Hanging + F3 · Tabular spec sheet
      knobs: columns=3, rules=every-row, numbers=tabular */}
  <section class="index">
    <div class="shell">
      <h2 class="index__heading">これまで</h2>
      <table class="index__table tnum">
        <caption class="visually-hidden">年・内容・役割の一覧</caption>
        <colgroup>
          <col class="index__col-year" />
          <col class="index__col-what" />
          <col class="index__col-role" />
        </colgroup>
        {
          groups.map((section) => (
            <tbody class="index__group">
              <tr class="index__group-head">
                <th class="index__group-label" colspan="3" scope="colgroup">
                  {section.group}
                </th>
              </tr>
              {section.rows.map((row) => (
                <tr class="index__row">
                  <td class="index__year">{row.year}</td>
                  <td class="index__what">
                    {row.href ? (
                      <a class="index__link" href={row.href} rel="noopener">
                        {row.what}
                      </a>
                    ) : (
                      row.what
                    )}
                  </td>
                  <td class="index__role">{row.role}</td>
                </tr>
              ))}
            </tbody>
          ))
        }
      </table>
    </div>
  </section>

  {/* CTA の見た目は Chip コンポーネントに集約している（design.md の CTA voice）。 */}
  <section class="close">
    <div class="shell">
      <Chip href="/resume/" label="職務経歴書を読む" />
    </div>
  </section>
</Base>

<style>
  .visually-hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* --- hero -------------------------------------------------------------
   * gate 44a は「下パディングを上の1.3倍以上に」とするが、ここでは従わない。
   * あの規則は eyebrow・見出し・リード文・CTA が積まれた背の高いヒーロー向けで、
   * 「次のセクションへ引き込む」ことが目的。
   * このヒーローは一行だけで、直後に太罫がある。罫線がすでに引き込みを
   * 担っているので、余白で二重にやると見出しと罫線の間が空いて見える。 */
  .hero {
    padding-block: var(--space-lg) var(--space-md);
  }

  .hero__display {
    /* 和文のディスプレイスケールを使う。--text-display（最大84px）は欧文前提で、
     * 和文は字幅が約2倍あるため過大になる。 */
    font-size: var(--text-display-ja);
    font-weight: 600;
    max-inline-size: 18em;
    text-wrap: balance;
  }

  /* --- now -------------------------------------------------------------- */
  .now {
    padding-block: var(--space-lg) var(--space-xl);
    display: grid;
  }

  /* --- index ------------------------------------------------------------ */
  .index {
    padding-block-end: var(--space-lg);
  }

  .index__heading {
    font-size: var(--text-lg);
    margin-block-end: var(--space-md);
  }

  .index__table {
    font-size: var(--text-base);
    table-layout: fixed;
    max-inline-size: 46rem;
  }

  .index__col-year {
    inline-size: 5rem;
  }

  .index__col-role {
    inline-size: 26%;
  }

  /* 群のラベル。text-transform: uppercase は和文には作用しないため使わない。
   * 字間と色と大きさだけでラベルとして読ませる。 */
  .index__group-head th {
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-align: start;
    color: var(--color-muted);
    padding-block: var(--space-lg) var(--space-2xs);
  }

  .index__group:first-of-type .index__group-head th {
    padding-block-start: 0;
  }

  .index__row {
    border-block-start: var(--rule-hair) solid var(--color-rule-2);
  }

  .index__row td {
    padding-block: var(--space-xs);
    vertical-align: baseline;
    text-align: start;
  }

  .index__year {
    font-family: var(--font-outlier);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .index__what {
    font-weight: 500;
  }

  .index__role {
    color: var(--color-ink-2);
    font-size: var(--text-sm);
  }

  .index__link {
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    transition:
      text-decoration-thickness var(--dur-short) var(--ease-out),
      text-decoration-color var(--dur-short) var(--ease-out);
  }

  .index__link:hover {
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-ink);
  }

  .index__link:active {
    color: var(--color-ink-2);
  }

  /* --- close ------------------------------------------------------------ */
  .close {
    padding-block: var(--space-2xl) 0;
  }

  /* --- 40rem 以下: タイポグラフィのブレークポイント --------------------- */
  @media (width < 40rem) {
    .index__table,
    .index__col-year,
    .index__col-role {
      inline-size: auto;
    }

    .index__table {
      table-layout: auto;
    }

    /* 表を行ごとのブロックに畳む。3列を375pxに詰めると役割列が2行になる。 */
    .index__row {
      display: grid;
      grid-template-columns: 4rem minmax(0, 1fr);
      column-gap: var(--space-sm);
      padding-block: var(--space-xs);
    }

    .index__row td {
      padding-block: 0;
    }

    .index__year {
      grid-row: 1 / span 2;
    }

    .index__role {
      color: var(--color-muted);
    }

    .index__group-head th {
      display: block;
    }
  }
</style>
