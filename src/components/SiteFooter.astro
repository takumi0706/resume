---
// Ft2 · Inline single line
// knobs: order=links/credit · separator=middot · density=spaced
//
// ヘッダーがリンクを持たないぶん、行き先はここが引き受ける。
// ただし列組みにはしない。4列インデックス＋ソーシャルアイコン行＋小さな著作権表示は
// anti-patterns.md が "The AI footer" として名指ししている形。

import { sections, elsewhere } from "@/config/site";
import BrandIcon from "@components/BrandIcon.astro";
import { splitLocale, localePath, locales, localeLabel } from "@i18n/config";
import { ui } from "@i18n/ui";

interface Props {
  /**
   * 言語切替えの行き先。既定はいま見ているページの対応する言語版。
   * 404 のように対応する言語版が無いページだけが明示的に渡す。
   * 渡さないと 404 のフッターが /en/404/ という存在しないパスを指す。
   */
  alternatePath?: string;
}

const { alternatePath } = Astro.props;

const { locale, path } = splitLocale(Astro.url.pathname);
const t = ui[locale];

// ページ上部の LocaleSwitch は絶対配置なので、読み終えた位置からは見えない。
// 切り替えるためだけに先頭へ戻らせないよう、閉じの帯にも1本置く。
const alternates = locales
  .filter((other) => other !== locale)
  .map((other) => ({
    label: localeLabel[other],
    href: localePath(other, alternatePath ?? path),
    lang: other,
  }));
---

<footer class="site-footer">
  <div class="shell">
    <hr class="rule-hair" />
    <div class="site-footer__row">
      <nav class="site-footer__links" aria-label={t.siteLinks}>
        {
          sections.map((item) => (
            <span class="site-footer__item">
              <a class="site-footer__link" href={localePath(locale, item.path)}>
                <span class="site-footer__label">{t.nav[item.key]}</span>
              </a>
            </span>
          ))
        }
      </nav>

      <nav class="site-footer__links" aria-label={t.externalLinks}>
        {
          elsewhere.map((item) => (
            <span class="site-footer__item">
              <a class="site-footer__link" href={item.href} rel={item.rel}>
                {item.icon && <BrandIcon slug={item.icon} />}
                <span class="site-footer__label">{item.label}</span>
              </a>
            </span>
          ))
        }
      </nav>

      <nav class="site-footer__links" aria-label={t.language}>
        {
          alternates.map((alternate) => (
            <span class="site-footer__item">
              <a
                class="site-footer__link"
                href={alternate.href}
                hreflang={alternate.lang}
                lang={alternate.lang}
              >
                <span class="site-footer__label">{alternate.label}</span>
              </a>
            </span>
          ))
        }
      </nav>

      {/* 氏名はここに置く。独立したワードマークを別に立てると、
          同じページ内で氏名が2回出て重複する。
          欧文表記にするのは、隣に並ぶ外部リンク名がすべて欧文のため。 */}
      <span class="site-footer__credit tnum">© 2026 Takumi Oyamada</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    /* 本文との間隔。--space-3xl(144px) は空きすぎだった。 */
    margin-block-start: var(--space-2xl);
    /* 著作権表示の下。ここが広いと、ページが終わったのに
       止まりきっていないように見える。 */
    padding-block-end: var(--space-md);
  }

  .site-footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-sm) var(--space-lg);
    padding-block-start: var(--space-md);
    font-size: var(--text-sm);
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-sm);
  }

  /* 中黒はリンクの外に置く。リンクの ::before にすると下線が引かれ、
     クリック領域にも入る。さらに inline-flex の最初の要素になるため、
     アイコンを持つリンクと持たないリンクでベースラインの基準が変わり、
     並びが揃わなくなる。 */
  .site-footer__item + .site-footer__item::before {
    content: "·";
    color: var(--color-muted);
    margin-inline-end: var(--space-sm);
  }

  /* inline のまま置く。inline-flex にするとベースラインの基準が
     最初のフレックス要素になり、アイコンの有無で並びがズレる。 */
  .site-footer__link {
    color: var(--color-ink-2);
    white-space: nowrap;
  }

  /* 下線はラベルにだけ引く。リンク全体に引くとアイコンの下にも線が走る。 */
  .site-footer__label {
    text-decoration: underline;
    text-decoration-color: var(--color-muted);
    text-decoration-thickness: 1px;
    /* gate 35: 下線は1〜2px、ベースラインからのオフセットも1〜2px。
     * 0.15em ≒ 2.4px。和文は欧文よりディセンダが深いのでこの程度が下限。 */
    text-underline-offset: 0.15em;
    transition:
      color var(--dur-short) var(--ease-out),
      text-decoration-color var(--dur-short) var(--ease-out);
  }

  .site-footer__link:hover .site-footer__label {
    text-decoration-color: var(--color-ink);
  }

  .site-footer__link:hover {
    color: var(--color-ink);
  }

  .site-footer__link:active {
    color: var(--color-muted);
  }

  .site-footer__credit {
    margin-inline-start: auto;
    color: var(--color-muted);
  }

  @media (width < 40rem) {
    .site-footer__row {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-md);
    }

    .site-footer__credit {
      margin-inline-start: 0;
    }

    .site-footer__link {
      min-block-size: 44px;
      display: inline-flex;
      align-items: center;
    }
  }
</style>
