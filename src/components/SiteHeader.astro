---
// N9 · Edge-aligned minimal
// knobs: cta=text+arrow · wordmark=monospace · padding-block=spacious
//
// リンク列は置かない。空白が設計そのもの。
// ここにリンクを4つ並べた瞬間に N1a（AI nav の指紋）になる。
// 行き先は下部のインデックスとフッターが引き受ける。
//
// CTA は1つだけなので、現在地に応じて行き先を変える。
// 職務経歴書を読んでいる人に職務経歴書へのリンクを出しても行き止まりになる。

const onResume = Astro.url.pathname.startsWith("/resume");

const cta = onResume
  ? { label: "連絡する", href: "https://x.com/1ye_q", external: true }
  : { label: "職務経歴書", href: "/resume/", external: false };
---

<header class="nav-edge">
  <div class="shell nav-edge__inner">
    <a class="wordmark" href="/">takumi0706</a>
    <a class="nav-cta" href={cta.href} rel={cta.external ? "me noopener" : undefined}>
      {cta.label}<span aria-hidden="true">→</span>
    </a>
  </div>
</header>

<style>
  .nav-edge {
    padding-block: var(--space-lg);
  }

  .nav-edge__inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .wordmark {
    font-family: var(--font-outlier);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    /* gate 49: クリック可能なテキストは決して2行にしない。 */
    white-space: nowrap;
    border-block-end: var(--rule-hair) solid var(--color-rule);
    padding-block-end: var(--space-3xs);
    transition:
      color var(--dur-short) var(--ease-out),
      border-color var(--dur-short) var(--ease-out);
  }

  .nav-cta:hover {
    color: var(--color-ink);
    border-block-end-color: var(--color-ink);
  }

  .nav-cta:active {
    color: var(--color-ink-2);
  }

  /* 矢印は本文書体のまま。outlier（Geist Mono）はワードマークと年号の
   * 2スロットに限る（2+1 ルール / gate 38）。 */

  @media (width < 40rem) {
    .nav-edge {
      padding-block: var(--space-md);
    }

    /* 44px の最小タップ領域を確保する。 */
    .nav-cta {
      min-block-size: 44px;
      align-items: center;
    }
  }
</style>
