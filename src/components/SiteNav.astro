---
import { sections, formalContact } from "@/config/site";
import { splitLocale, localePath, locales, localeLabel } from "@i18n/config";
import { ui } from "@i18n/ui";

// N3 · Side-rail
// knobs: side=left · width=16ch · indicator=filled bar
//
// 前は N9 Edge-aligned minimal（リンク列なし）だった。空白を設計にする形だが、
// 行き先が6つあるサイトでこれは誤りだった。訪問者はフッターまでスクロールしないと
// 他のページの存在に気づけない。gate 42 も「リンクの無いナビは行き先が2つの場合のみ
// 正当化される」としている。
//
// N3 の基本形は回転ワードマーク＋ドット表示だが、それはページ内セクション用。
// 「読まずに分かる」ことが目的なので、回転させずラベルを出す。

interface Props {
  /**
   * 言語切替えの行き先。既定はいま見ているページの対応する言語版。
   * 対応する言語版が存在しないページ（404）だけが、明示的に別の行き先を渡す。
   */
  alternatePath?: string;
}

const { alternatePath } = Astro.props;

const { locale, path } = splitLocale(Astro.url.pathname);
const t = ui[locale];

// 末尾スラッシュの有無に関わらず現在地を判定する。
// ロケールを外した path で比べるので、/en/ でもそのまま効く。
const normalise = (value: string): string => value.replace(/\/+$/, "") || "/";
const isCurrent = (target: string): boolean => normalise(path) === normalise(target);

// 言語切替え。いま見ているページの対応する言語版へ送る。
// 一律でトップに送ると、読んでいたページを見失う。
const alternates = locales
  .filter((other) => other !== locale)
  .map((other) => ({
    label: localeLabel[other],
    href: localePath(other, alternatePath ?? path),
    lang: other,
  }));
---

<nav class="rail" aria-label={t.siteLinks}>
  <div class="rail__inner">
    <a
      class="rail__brand"
      href={localePath(locale, "/")}
      aria-current={isCurrent("/") ? "page" : undefined}
    >
      {/* リンクのテキストが名前を伝えるので、画像は装飾扱いにして alt を空にする。
          幅と高さを明示して読み込み時のずれを防ぐ。 */}
      <img
        class="rail__avatar"
        src="/avatar.png"
        alt=""
        width="40"
        height="40"
        decoding="async"
      />
      <span class="rail__wordmark">takumi0706</span>
    </a>

    <ul class="rail__list">
      {
        sections.map((section) => (
          <li>
            <a
              class="rail__link"
              href={localePath(locale, section.path)}
              aria-current={isCurrent(section.path) ? "page" : undefined}
            >
              {t.navShort[section.key]}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="rail__foot">
      {/* 言語切替え。相手の言語でラベルを書く（英語ページには「日本語」と出す）。
          hreflang を付けて、切替え先が何語かを機械にも伝える。 */}
      {alternates.map((alternate) => (
        <a class="rail__lang" href={alternate.href} hreflang={alternate.lang} lang={alternate.lang}>
          {alternate.label}
        </a>
      ))}

      <a class="rail__contact" href={formalContact.href} rel={formalContact.rel}>
        {t.railContact}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</nav>

<style>
  .rail {
    grid-area: rail;
  }

  .rail__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-lg) var(--space-md) var(--space-lg) var(--page-gutter);
  }

  /* Marquee Hero は「フォールドに画像を置かない」形なので、
     本人のアイコンはヒーローではなくクローム側に置く。
     全ページに出るため、文字だけのページに視覚的な取っかかりができる。 */
  .rail__brand {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  /* 60rem 以上ではレールが狭いので縦に積む。
     横並びだとアバター40px + ワードマークがレール幅(8.5rem)を超え、
     本文の見出しに重なる。 */
  @media (width >= 60rem) {
    .rail__brand {
      flex-direction: column;
      align-items: start;
      gap: var(--space-2xs);
    }
  }

  .rail__avatar {
    inline-size: 40px;
    block-size: 40px;
    border-radius: var(--radius-sm);
    /* ピクセルアートなので拡大縮小で滑らかにしない。 */
    image-rendering: pixelated;
  }

  .rail__wordmark {
    font-family: var(--font-outlier);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .rail__list {
    display: grid;
    gap: var(--space-3xs);
  }

  .rail__link {
    display: block;
    /* gate 49: クリック可能なテキストは決して2行にしない。 */
    white-space: nowrap;
    /* 現在地の帯を置くぶんだけ内側に寄せる。 */
    padding: var(--space-3xs) 0 var(--space-3xs) var(--space-sm);
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    border-inline-start: 2px solid transparent;
    transition:
      color var(--dur-short) var(--ease-out),
      border-color var(--dur-short) var(--ease-out);
  }

  .rail__link:hover {
    color: var(--color-ink);
    border-inline-start-color: var(--color-rule);
  }

  .rail__link:active {
    color: var(--color-muted);
  }

  /* 現在地。色ではなく帯で示す。色だけだと見分けがつきにくい。 */
  .rail__link[aria-current="page"] {
    color: var(--color-ink);
    font-weight: 600;
    border-inline-start-color: var(--color-ink);
  }

  .rail__foot {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    align-items: start;
  }

  /* 言語切替え。現在地の帯（レールのリンク）と区別するため下線で出す。 */
  .rail__lang {
    font-size: var(--text-sm);
    color: var(--color-muted);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--color-rule);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    transition:
      color var(--dur-short) var(--ease-out),
      text-decoration-color var(--dur-short) var(--ease-out);
  }

  .rail__lang:hover {
    color: var(--color-ink);
    text-decoration-color: var(--color-ink);
  }

  .rail__lang:active {
    color: var(--color-muted);
  }

  /* 罫線は引かない。ページを閉じる線はフッターの全幅の1本だけにする。
     ここにも引くと、レール幅の短い線と本文幅の線が近い高さで2本並ぶ。 */
  .rail__contact {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    white-space: nowrap;
    transition: color var(--dur-short) var(--ease-out);
  }

  .rail__contact:hover {
    color: var(--color-ink);
  }

  /* 60rem 以上: 左端に固定して常時見せる。 */
  @media (width >= 60rem) {
    .rail__inner {
      position: sticky;
      inset-block-start: 0;
      min-block-size: 100dvh;
      justify-content: start;
    }

    .rail__foot {
      margin-block-start: auto;
    }
  }

  /* 60rem 未満: 上部に横並びで畳む。固定はしない（画面が狭いので場所を食う）。 */
  @media (width < 60rem) {
    .rail__inner {
      padding: var(--space-md) var(--page-gutter);
      gap: var(--space-sm);
    }

    .rail__list {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2xs) var(--space-md);
    }

    .rail__link {
      padding: var(--space-3xs) 0;
      border-inline-start: 0;
      border-block-end: 2px solid transparent;
    }

    .rail__link:hover {
      border-inline-start-color: transparent;
      border-block-end-color: var(--color-rule);
    }

    .rail__link[aria-current="page"] {
      border-inline-start-color: transparent;
      border-block-end-color: var(--color-ink);
    }

    .rail__contact {
      display: none;
    }

    .rail__foot {
      flex-direction: row;
      gap: var(--space-md);
    }
  }

  /* 40rem 未満: タップ領域を確保する。 */
  @media (width < 40rem) {
    .rail__link {
      min-block-size: 44px;
      display: flex;
      align-items: center;
    }
  }
</style>
