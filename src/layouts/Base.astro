---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
// 和文は scripts/subset-jp-font.mjs が生成したサブセットを使う。理由は fonts.css を参照。
import "@styles/fonts.css";
// 和文サブセットのパスは生成物。ハッシュ付きなのでここから引く。
import fontPaths from "@/data/fonts.json";
import "@styles/tokens.css";
import "@styles/base.css";
import SiteNav from "@components/SiteNav.astro";
import SiteFooter from "@components/SiteFooter.astro";
import LocaleSwitch from "@components/LocaleSwitch.astro";
import {
  splitLocale,
  localePath,
  locales,
  htmlLang,
  ogLocale,
  defaultLocale,
} from "@i18n/config";
import { ui } from "@i18n/ui";

interface Props {
  title: string;
  description: string;
  /**
   * 和文の太いウェイト(600)を先読みするか。
   *
   * 見出しに和文を持つページは true。持たないページで先読みすると 41KB を
   * 落として捨てることになる（ブラウザが「preload したのに使われていない」と
   * 警告を出す）。既定は true で、使わないページ側が明示的に false にする。
   */
  preloadDisplayWeight?: boolean;
  /**
   * 言語切替えと hreflang の行き先。既定はいま見ているページの対応する言語版。
   * 404 のように対応する言語版が無いページだけが明示的に渡す。
   */
  alternatePath?: string;
}

const { title, description, preloadDisplayWeight = true, alternatePath } = Astro.props;

const { locale, path: currentPath } = splitLocale(Astro.url.pathname);
const path = alternatePath ?? currentPath;
const t = ui[locale];

// 和文フォントは日本語ページだけが要る。
// 英語ページで先読みすると、使わない 100KB 超を落として捨てることになる。
const needsJapaneseFont = locale === "ja";

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// 言語版の相互参照。x-default は既定（日本語）に向ける。
const alternates = locales.map((other) => ({
  hreflang: htmlLang[other],
  href: new URL(localePath(other, path), Astro.site).href,
}));
const xDefault = new URL(localePath(defaultLocale, path), Astro.site).href;

// OGP カードは scripts/build-og.mjs が dist/og/ に焼く。
// ファイル名はここと同じ規則で付いている（"/" は index、"/resume/" は resume）。
const ogSlug = Astro.url.pathname.replace(/^\/+|\/+$/g, "").replace(/\//g, "-") || "index";
const ogImage = new URL(`/og/${ogSlug}.png`, Astro.site).href;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* 和文サブセットは LCP に効くので先読みする。公開パスが固定なので preload できる。
        ただし実際に使うウェイトだけを先読みする。 */}
    {
      needsJapaneseFont && preloadDisplayWeight && (
        <link
          rel="preload"
          href={fontPaths["600"]}
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
    {
      needsJapaneseFont && (
        <link
          rel="preload"
          href={fontPaths["400"]}
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content={ogLocale[locale]} />
    {
      locales
        .filter((other) => other !== locale)
        .map((other) => (
          <meta property="og:locale:alternate" content={ogLocale[other]} />
        ))
    }
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {/* 寸法を書くと、画像を取りに行く前に枠を確保できる。 */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/* title に氏名が入っているので、ここで足すと同じ名前が2回出る。 */}
    <meta property="og:image:alt" content={title} />
    <link rel="canonical" href={canonical} />
    {/* 言語版の相互参照。片方向だけだと検索側が別ページとして扱う。 */}
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    {/* 1200x630 の横長カードなので large を使う。
        以前は正方形のアイコンを出していたため summary にしていた。 */}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <div class="page">
      {/* 言語切替えは本文カラムの右上。DOM 上も本文より前に置いて、
          タブ移動で早い段階に触れられるようにする。 */}
      <LocaleSwitch alternatePath={alternatePath} />
      <SiteNav />
      <main class="page__main" id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

<style>
  /* サイドレールと本文の2カラム。60rem 未満では縦に積む。 */
  .page {
    display: grid;
    /* 言語切替えの絶対配置の基準。 */
    position: relative;
    grid-template-areas:
      "rail"
      "main"
      "footer";
  }

  .page__main {
    grid-area: main;
    min-inline-size: 0;
  }

  .page :global(.site-footer) {
    grid-area: footer;
  }

  @media (width >= 60rem) {
    .page {
      grid-template-columns: var(--rail-width) minmax(0, 1fr);
      /* フッターは全幅。レールはその手前で終わらせる。
       *
       * 以前は "rail footer" にしてレールをページ最下部まで貫かせていた。
       * すると sticky の解除位置がページ末尾になり、レール下端の「連絡する」が
       * フッターの帯の内側に落ちてくる。閉じの罫線がレール幅と本文幅で2本並び、
       * 高さも揃わない（罫線で31px、文字で16pxずれていた）。
       *
       * 閉じる線は1本でよい。全幅にすればレール側も終端されるうえ、
       * sticky はフッターの手前で解除され、揃える対象そのものが無くなる。 */
      grid-template-areas:
        "rail main"
        "footer footer";
      max-inline-size: calc(var(--rail-width) + var(--page-max));
      margin-inline: auto;
      /* align-items: start にすると .rail の高さが中身の分（100dvh）しか
         なくなり、そこを通り過ぎた時点で内側の sticky が効かなくなる。
         既定の stretch のまま、レールをページ全高に伸ばす。 */
    }

    /* レールと本文をひとまとまりとして中央に置く。
     *
     * 本文だけを中央寄せにするとレールとの間に隙間が空き、
     * 本文だけを左詰めにすると右側に大きな空白が残る。
     * どちらもレールを画面の左端に貼り付けたまま考えたのが誤りだった。 */
    .page :global(.shell) {
      margin-inline: 0;
    }

    /* フッターだけは本文幅に閉じ込めない。レール幅ぶん左に空白が残り、
       閉じの帯が本文カラムにしか掛かっていないように見える。 */
    .page :global(.site-footer .shell) {
      max-inline-size: none;
    }
  }

  .skip-link {
    position: absolute;
    inset-block-start: var(--space-2xs);
    inset-inline-start: var(--space-2xs);
    z-index: var(--z-overlay);
    padding: var(--space-2xs) var(--space-sm);
    background-color: var(--color-ink);
    color: var(--color-paper);
    font-size: var(--text-sm);
    border-radius: var(--radius-sm);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
