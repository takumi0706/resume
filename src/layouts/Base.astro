---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
// 和文は scripts/subset-jp-font.mjs が生成したサブセットを使う。理由は fonts.css を参照。
import "@styles/fonts.css";
// 和文サブセットのパスは生成物。ハッシュ付きなのでここから引く。
import fontPaths from "@/data/fonts.json";
import "@styles/tokens.css";
import "@styles/base.css";
import SiteNav from "@components/SiteNav.astro";
import SiteFooter from "@components/SiteFooter.astro";

interface Props {
  title: string;
  description: string;
  /**
   * 和文の太いウェイト(600)を先読みするか。
   *
   * 見出しに和文を持つページは true。持たないページで先読みすると 41KB を
   * 落として捨てることになる（ブラウザが「preload したのに使われていない」と
   * 警告を出す）。既定は true で、使わないページ側が明示的に false にする。
   */
  preloadDisplayWeight?: boolean;
}

const { title, description, preloadDisplayWeight = true } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL("/icon.png", Astro.site).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* 和文サブセットは LCP に効くので先読みする。公開パスが固定なので preload できる。
        ただし実際に使うウェイトだけを先読みする。 */}
    {
      preloadDisplayWeight && (
        <link
          rel="preload"
          href={fontPaths["600"]}
          as="font"
          type="font/woff2"
          crossorigin
        />
      )
    }
    <link
      rel="preload"
      href={fontPaths["400"]}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <link rel="canonical" href={canonical} />
    {/* アイコンは正方形なので summary_large_image ではなく summary を使う。
        横長でない画像を large 指定すると左右が切られる。 */}
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <div class="page">
      <SiteNav />
      <main class="page__main" id="main">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

<style>
  /* サイドレールと本文の2カラム。60rem 未満では縦に積む。 */
  .page {
    display: grid;
    grid-template-areas:
      "rail"
      "main"
      "footer";
  }

  .page__main {
    grid-area: main;
    min-inline-size: 0;
  }

  .page :global(.site-footer) {
    grid-area: footer;
  }

  @media (width >= 60rem) {
    .page {
      grid-template-columns: var(--rail-width) minmax(0, 1fr);
      grid-template-areas:
        "rail main"
        "rail footer";
      max-inline-size: calc(var(--rail-width) + var(--page-max));
      margin-inline: auto;
      /* align-items: start にすると .rail の高さが中身の分（100dvh）しか
         なくなり、そこを通り過ぎた時点で内側の sticky が効かなくなる。
         既定の stretch のまま、レールをページ全高に伸ばす。 */
    }

    /* レールと本文をひとまとまりとして中央に置く。
     *
     * 本文だけを中央寄せにするとレールとの間に隙間が空き、
     * 本文だけを左詰めにすると右側に大きな空白が残る。
     * どちらもレールを画面の左端に貼り付けたまま考えたのが誤りだった。 */
    .page :global(.shell) {
      margin-inline: 0;
    }
  }

  .skip-link {
    position: absolute;
    inset-block-start: var(--space-2xs);
    inset-inline-start: var(--space-2xs);
    z-index: var(--z-overlay);
    padding: var(--space-2xs) var(--space-sm);
    background-color: var(--color-ink);
    color: var(--color-paper);
    font-size: var(--text-sm);
    border-radius: var(--radius-sm);
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
