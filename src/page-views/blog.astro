---
import { getCollection } from "astro:content";
import Base from "@layouts/Base.astro";
import { splitLocale } from "@i18n/config";
import { ui, fill } from "@i18n/ui";
import { shortDate } from "@i18n/format";

// 13 · Index-First
// ページそのものがリンクの目録。ヒーローも物語の流れも持たない。
// 見出しは冒頭の短い一段落だけで、ディスプレイサイズの文字は使わない。
// リンクそのものがボタンであり、別途 CTA を置かない。

const { locale } = splitLocale(Astro.url.pathname);
const t = ui[locale];

const writing = await getCollection("writing");

const articles = [...writing].sort((a, b) =>
  b.data.publishedAt.localeCompare(a.data.publishedAt),
);

// 年でまとめる。目録は時間軸で引けると探しやすい。
const years = [...new Set(articles.map((article) => article.data.publishedAt.slice(0, 4)))];

const byYear = years.map((year) => ({
  year,
  items: articles.filter((article) => article.data.publishedAt.startsWith(year)),
}));

const total = articles.length;
const range =
  articles.length > 0
    ? `${articles.at(-1)?.data.publishedAt.slice(0, 4)} — ${articles[0].data.publishedAt.slice(0, 4)}`
    : "";

---

<Base title={t.blogTitle} description={t.blogDescription} preloadDisplayWeight={false}>
  <article class="index-page">
    <div class="shell">
      {/* 目録の見出しはこの一段落。<p> にしていたためページに h1 が無く、
          見出しジャンプの着地点が無い文書になっていた。
          見た目は変えずに h1 にする（Index-First はディスプレイサイズを使わない）。 */}
      <h1 class="index-page__lede tnum">{fill(t.blogLede, { range, count: total })}</h1>

      {
        byYear.map((group) => (
          <section class="year">
            <h2 class="year__label tnum">{group.year}</h2>
            <ul class="entries">
              {group.items.map((article) => (
                <li class="entry">
                  <span class="entry__date tnum">
                    {shortDate(locale, article.data.publishedAt)}
                  </span>
                  <a class="entry__link" href={article.data.url} rel="noopener">
                    {article.data.title}
                  </a>
                  <span class="entry__meta tnum">
                    {article.data.likes > 0 && (
                      <span class="entry__likes">{article.data.likes}♡</span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </article>
</Base>

<style>
  .index-page {
    padding-block: var(--space-lg) var(--space-2xl);
  }

  /* 目録の見出しは一段落だけ。ディスプレイサイズは使わない。 */
  .index-page__lede {
    color: var(--color-muted);
    font-size: var(--text-sm);
    /* h1 の UA 既定は bold。段落だったときの見た目を保つために明示する。 */
    font-weight: 400;
    margin-block-end: var(--space-xl);
  }

  .year + .year {
    margin-block-start: var(--space-xl);
  }

  .year__label {
    font-family: var(--font-outlier);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-muted);
    margin-block-end: var(--space-2xs);
  }

  .entries {
    display: grid;
    max-inline-size: 46rem;
  }

  /* 仕切りは各行のヘアライン。 */
  .entry {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) 3.5rem;
    gap: var(--space-sm);
    align-items: baseline;
    padding-block: var(--space-xs);
    border-block-start: var(--rule-hair) solid var(--color-rule-2);
  }

  .entry__date {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  /* リンクそのものがボタン。別の CTA は置かない。 */
  .entry__link {
    text-decoration: underline;
    text-decoration-color: var(--color-muted);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
    transition:
      text-decoration-thickness var(--dur-short) var(--ease-out),
      text-decoration-color var(--dur-short) var(--ease-out);
  }

  .entry__link:hover {
    text-decoration-thickness: 2px;
    text-decoration-color: var(--color-ink);
  }

  .entry__link:active {
    color: var(--color-ink-2);
  }

  .entry__meta {
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-align: end;
  }

  @media (width < 40rem) {
    .entry {
      grid-template-columns: 3.5rem minmax(0, 1fr);
      row-gap: var(--space-3xs);
    }

    .entry__meta {
      grid-column: 2;
      text-align: start;
    }
  }
</style>
